// wristalk.app website: static files from the repo root + worker/index.js for /.well-known, /join/*, www redirect.
// Deploy: npx wrangler deploy (from this folder). Custom domains wristalk.app + www (zone active since 2026-10-07 UTC).
{
  "name": "wristalk-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "wristalk.app", "custom_domain": true },
    { "pattern": "www.wristalk.app", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
